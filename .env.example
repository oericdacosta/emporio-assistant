# Copie para .env (que não vai para o repositório) e preencha. Nunca coloque chaves em código.
OPENAI_API_KEY=
LLM_MODEL=
# Relógio de referência: os pedidos e prazos dos dados são de 2025-2026 (o último pedido é de 22/03/2026).
# Apague a linha para usar o relógio real.
AGENT_NOW=2026-03-23T10:00
# Tracing no LangSmith (ligado por padrão). Sem a chave o app funciona, só avisa que não envia traces.
# Se a conta for da UE, descomente: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-teo
